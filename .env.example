# Copy to .env (or export these) before starting the server.
WEBHOOK_SECRET=pick-a-long-random-string-for-the-wearer-app
CARETAKER_KEY=pick-another-long-random-string-for-the-caretaker-app
# Path to the Firebase service-account key you downloaded (leave empty for log-only mode)
FIREBASE_CREDENTIALS=./firebase-service-account.json
DB_PATH=guardian.db
